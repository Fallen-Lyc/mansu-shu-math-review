      "stem": "一个长方形的长是8厘米，宽是5厘米，它的周长是（  ）厘米。",
      "spans": [
        { "text": "一个", "kind": "none" },
        { "text": "长方形", "kind": "fig" },
        { "text": "的", "kind": "none" },
        { "text": "长是8厘米", "kind": "cond" },
        { "text": "，", "kind": "none" },
        { "text": "宽是5厘米", "kind": "cond" },
        { "text": "，它的", "kind": "none" },
        { "text": "周长是（  ）厘米", "kind": "ques" },
        { "text": "。", "kind": "none" }
      ],
      "knowledge": ["长方形周长"],
      "analysis": {
        "exam_point": "考长方形周长的计算方法",
        "key_conditions": "长8厘米、宽5厘米是求周长必须知道的两个条件",
        "relation": "长方形有2条长和2条宽，围成一圈才是周长",
        "quantity_relation": "周长 = （长 + 宽）× 2"
      },
      "mistakes": [
        {
          "wrong": "8+5=13（厘米）",
