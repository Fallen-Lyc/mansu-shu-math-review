        }
      ],
      "solutions": [
        {
          "name": "方法一：用公式",
          "steps": [
            { "label": "周长", "expr": "（8 + 5）× 2", "value": "26", "unit": "厘米", "note": "先算长加宽的和" },
            { "label": "检验", "expr": "8+5+8+5", "value": "26", "unit": "厘米", "note": "四条边连加，结果一样" }
          ]
        }
      ],
      "answer": "答：它的周长是26厘米。"
    },
    {
