      "stem": "学校买来3箱粉笔，每箱24盒，用去28盒，还剩多少盒？",
      "knowledge": ["两步计算", "乘加乘减"],
      "analysis": {
        "exam_point": "考先求总数再求剩余的两步计算",
        "key_conditions": "3箱、每箱24盒决定总数；用去28盒要从总数里去掉",
        "relation": "先算一共买来多少盒，再去掉用掉的，才是剩下的",
        "quantity_relation": "剩下 = 每箱盒数 × 箱数 − 用去的盒数"
      },
      "mistakes": ["24−3−28，把「3箱」当成了3盒；先分清每份数和份数，24×3才是总数"],
      "solutions": [
        {
          "name": "方法一：先求一共",
          "steps": [
            { "label": "一共", "expr": "24 × 3", "value": "72", "unit": "盒" },
            { "label": "还剩", "expr": "72 − 28", "value": "44", "unit": "盒" }
          ]
        },
        {
          "name": "方法二：综合算式",
          "steps": [{ "label": "脱式", "lines": ["24 × 3 − 28", "= 72 − 28", "= 44（盒）"] }]
        }
      ],
      "answer": "答：还剩44盒。"
    },
    {
